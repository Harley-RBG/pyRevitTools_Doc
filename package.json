{
  "name": "comp-design-wiki",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "bundle:update": "node scripts/update-bundle.mjs",
    "generate": "node scripts/generate-static-site.mjs",
    "generate:dev": "node scripts/generate-static-site.mjs --index-only",
    "generate:quick": "node scripts/generate-static-site.mjs --index-only",
    "generate:full": "node scripts/generate-static-site.mjs --full-ui",
    "generate:force": "node scripts/generate-static-site.mjs --force",
    "site:update": "npm run bundle:update && npm run generate",
    "site:update:quick": "npm run bundle:update && npm run generate:quick",
    "preview": "npx --yes serve . -l 4173"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  }
}
